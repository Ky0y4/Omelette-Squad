    },
    {
      "condition": "student_goal == 'high_salary'",
      "recommendation": "Choose careers in technology, engineering, or specialized healthcare"
    },
    {
      "condition": "student_goal == 'job_security'",
      "recommendation": "Choose stable fields like healthcare, education, or trades"
    },
    {
      "condition": "student_uncertain == true",
      "recommendation": "Start with digital literacy and explore data, business, or tech-related skills"
    }
